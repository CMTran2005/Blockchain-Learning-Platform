# Server
PORT=5000
CLIENT_URL=http://localhost:3000
NODE_ENV=development

# ============================================================
# FIREBASE — Database chính (metadata, links, records)
# ============================================================
FIREBASE_SERVICE_ACCOUNT_PATH=./src/config/serviceAccountKey.json

# ============================================================
# CLOUDINARY — Media storage (video, ảnh, PDF, slides)
# Đăng ký: https://cloudinary.com (miễn phí 25GB)
# ============================================================
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# ============================================================
# PINATA IPFS — Immutable metadata (certificate JSON, course snapshot)
# Đăng ký: https://pinata.cloud (miễn phí 1GB — đủ cho JSON)
# Khuyến nghị: dùng JWT (an toàn hơn API Key)
# ============================================================
PINATA_JWT=your_pinata_jwt_token
PINATA_API_KEY=your_pinata_api_key
PINATA_API_SECRET=your_pinata_api_secret
PINATA_GATEWAY=https://gateway.pinata.cloud

# ============================================================
# BLOCKCHAIN — Ganache local / EVM network
# ============================================================
# RPC_URL: Ganache default port 7545
RPC_URL=http://127.0.0.1:7545

# PRIVATE_KEY: Private key của admin wallet (ký giao dịch on-chain)
# Lấy từ Ganache UI → Account → Key icon
PRIVATE_KEY=0xyour_ganache_private_key

# CONTRACT_ADDRESS: Địa chỉ contract sau khi chạy npm run deploy trong smart-contract/
# Ví dụ: 0xAbCd1234...
CONTRACT_ADDRESS=0xyour_contract_address_after_deploy

# ADMIN_ADDRESSES: Các wallet có quyền admin (phân cách bằng dấu phẩy)
ADMIN_ADDRESSES=0xyour_admin_wallet_address
